{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "strictPropertyInitialization": false,
    "module": "esnext",
    "target": "es2022",
    // "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,     
    "noUnusedLocals": true ,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["./tests/", "./node_modules/", "./dist/"]
}
